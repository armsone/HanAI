{
  "schemaVersion": 1,
  "golfModelVersion": "0.7.0",
  "kind": "puttStroke",
  "description": "GolfPuttStrokeAnalyzer(무음 퍼팅 안전망) 검증. 아이언 반례는 2026-08-24 아이언 negative label 학습 메모를 수치로 옮긴 합성 시퀀스다.",
  "defaults": {
    "handY": 0.0,
    "coreX": 0.5,
    "coreY": 0.5,
    "bodyScale": 0.2,
    "confidence": 0.9
  },
